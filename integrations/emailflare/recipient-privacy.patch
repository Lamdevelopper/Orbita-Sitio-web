diff --git a/services/worker/migrations/0004_recipient_privacy.sql b/services/worker/migrations/0004_recipient_privacy.sql
new file mode 100644
index 0000000..cce140c
--- /dev/null
+++ b/services/worker/migrations/0004_recipient_privacy.sql
@@ -0,0 +1,41 @@
+-- Recipient addresses are transient delivery inputs. Persist only a mask and
+-- keyed digest so the EmailFlare control plane cannot reveal subscribers.
+CREATE TABLE email_logs_private (
+  id               TEXT PRIMARY KEY,
+  to_masked        TEXT NOT NULL,
+  to_hash          TEXT NOT NULL,
+  from_address     TEXT NOT NULL,
+  subject          TEXT NOT NULL,
+  status           TEXT NOT NULL DEFAULT 'pending',
+  cf_message_id    TEXT,
+  domain_id        TEXT,
+  template_id      TEXT,
+  api_key_id       TEXT,
+  idempotency_key  TEXT,
+  error            TEXT,
+  is_test          INTEGER NOT NULL DEFAULT 0,
+  html_body        TEXT,
+  text_body        TEXT,
+  sent_at          TEXT NOT NULL
+);
+
+INSERT INTO email_logs_private (
+  id, to_masked, to_hash, from_address, subject, status, cf_message_id,
+  domain_id, template_id, api_key_id, idempotency_key, error, is_test,
+  html_body, text_body, sent_at
+)
+SELECT
+  id, '[legacy redacted]', 'legacy:' || id, from_address, subject, status,
+  cf_message_id, domain_id, template_id, api_key_id, idempotency_key, error,
+  is_test, html_body, text_body, sent_at
+FROM email_logs;
+
+DROP TABLE email_logs;
+ALTER TABLE email_logs_private RENAME TO email_logs;
+CREATE INDEX idx_logs_sent_at ON email_logs(sent_at);
+CREATE INDEX idx_logs_status ON email_logs(status);
+CREATE INDEX idx_logs_api_key ON email_logs(api_key_id);
+CREATE INDEX idx_logs_domain ON email_logs(domain_id);
+CREATE INDEX idx_logs_recipient_hash ON email_logs(to_hash);
+CREATE UNIQUE INDEX idx_logs_idempotency ON email_logs(idempotency_key)
+  WHERE idempotency_key IS NOT NULL;
